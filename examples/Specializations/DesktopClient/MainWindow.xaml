<Window x:Class="DesktopClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Expense report — C# practicum" Width="600" Height="400">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Expense report (amounts in minor currency units)" FontSize="18" />
      <TextBlock x:Name="StateText" Text="{Binding State}" Margin="0,10" AutomationProperties.Name="State" />
      <TextBlock Text="{Binding Error}" Foreground="DarkRed" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,10">
        <Button x:Name="LoadButton" Content="Load" Command="{Binding LoadCommand}" Padding="15,6" />
        <Button Content="Cancel" Command="{Binding LoadCancelCommand}" Margin="10,0" Padding="15,6" />
      </StackPanel>
    </StackPanel>
    <DataGrid x:Name="ReportGrid" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
        <DataGridTextColumn Header="Count" Binding="{Binding Count}" />
        <DataGridTextColumn Header="Amount (minor)" Binding="{Binding AmountMinor}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
